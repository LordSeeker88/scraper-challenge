# Default CLI language (es | pt | en)
SCRAPER_LANG=es

# Politeness delay between HTTP requests, in milliseconds
SCRAPER_DELAY_MS=1500

# Maximum attempts per request before giving up (429 handling)
SCRAPER_MAX_ATTEMPTS=5

# Optional HTTP proxy (e.g. a local VPN tunnel): http://127.0.0.1:3128
SCRAPER_PROXY=

# Output directory for results/PDFs/checkpoints (relative to project root)
SCRAPER_DATA_DIR=data
